# The bridge is loopback-only by default. Do not expose it on a public interface.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=9123
# Set a long, random value when the DukaPilot web app will call the bridge.
BRIDGE_TOKEN=
BRIDGE_ALLOWED_ORIGINS=https://www.dukapilot.com,https://dukapilot.com,http://localhost:3000

PRINTER_ID=default
PRINTER_NAME=Xprinter XP-D281B
PRINTER_PROTOCOL=TSPL
PRINTER_CONNECTION=NETWORK
PRINTER_LAN_IP=192.168.1.120
PRINTER_TCP_PORT=9100
PRINTER_TIMEOUT_MS=10000
