# ============================================================
# DukaPilot Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://dukapilot:dukapilot_secret@localhost:5432/dukapilot"
# Migration URL -- public TCP proxy, only needed for prisma migrate deploy at startup
# On Railway: set to the public Postgres URL (e.g. trolley.proxy.rlwy.net:PORT)
DATABASE_MIGRATE_URL=

# --- JWT ---
# MUST be a long random secret in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change_this_to_a_long_random_secret_in_production"

# --- Server ---
PORT=4000
NODE_ENV=development

# --- CORS ---
# Add your Vercel frontend URL here if not using the default
FRONTEND_URL=
VERCEL_FRONTEND_URL=

# --- NextSMS (OTP / SMS) ---
# Required for live PIN recovery. Use the exact approved sender ID from NextSMS.
# API documentation: https://documenter.getpostman.com/view/1679195/2sAYkDP1XN
SMS_PROVIDER=NEXTSMS
NEXTSMS_API_KEY=
# Use the exact approved sender spelling from NextSMS. The current approved ID is Dukapilot.
NEXTSMS_SENDER_ID=Dukapilot
NEXTSMS_API_URL=https://messaging-service.co.tz/api/sms/v2/text/single
# Platform-admin monitoring only. Defaults to https://messaging-service.co.tz/api/v2.
NEXTSMS_MONITOR_BASE_URL=https://messaging-service.co.tz/api/v2

# --- Africa's Talking (legacy local fallback only) ---
# Leave empty in production after moving to NextSMS.
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=

# --- Meta WhatsApp Cloud API (optional) ---
# The API base URL includes the Graph version, for example https://graph.facebook.com/v23.0.
# Keep the token in Railway only. PIN recovery also needs an approved template.
WHATSAPP_API_URL=https://graph.facebook.com/v23.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
# Keep false for normal production. Free-form text is only valid inside a
# customer-initiated 24-hour WhatsApp service window.
WHATSAPP_ENABLE_FREEFORM=false

# --- Meta WhatsApp Cloud API webhook (optional) ---
# Add all values in Railway only. Never commit or paste tokens into source code.
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# --- Meta WhatsApp Business App coexistence (platform admin only) ---
# Required to exchange the short-lived Embedded Signup code server-side.
META_APP_ID=
META_APP_SECRET=
# Optional Graph version override for the server-side verification calls.
META_GRAPH_API_URL=https://graph.facebook.com/v25.0

# --- Email: Mailtrap outbound sending ---
# Mailtrap sends app-generated email. ImprovMX handles inbound forwarding in DNS.
MAIL_FROM="DukaPilot <noreply@dukapilot.com>"
MAIL_REPLY_TO=support@dukapilot.com
# Use either Mailtrap API or SMTP values from your Mailtrap dashboard.
MAILTRAP_API_TOKEN=
MAILTRAP_SMTP_HOST=live.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=587
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=

# --- Email: ImprovMX inbound forwarding ---
# This is documented here for operations only; the app does not connect to ImprovMX.
SUPPORT_EMAIL=support@dukapilot.com

# --- Sentry Error Tracking (optional) ---
# Get your DSN from https://sentry.io/
SENTRY_DSN=

# --- Database Backups ---
# Directory to write backups to (default: ./backups). Local Windows runs should
# use LOCAL_BACKUP_DIR through the tracked PowerShell wrapper instead.
BACKUP_DIR=./backups
# Local-only directory that overrides BACKUP_DIR without changing Railway vars.
LOCAL_BACKUP_DIR=
# Number of days to retain backup files
BACKUP_RETAIN_DAYS=7
# Optional explicit source URL. The backup script otherwise prefers
# DATABASE_MIGRATE_URL then DATABASE_URL. Do not save production URLs locally.
BACKUP_DATABASE_URL=
# Optional executable paths when PostgreSQL client tools are not on PATH.
PG_DUMP_PATH=
PG_RESTORE_PATH=
PSQL_PATH=
# Docker fallback image for local Windows backups when Docker Desktop is running.
BACKUP_DOCKER_POSTGRES_IMAGE=postgres:16-alpine
# Off-site backup (Cloudflare R2 / AWS S3). Leave BACKUP_S3_BUCKET empty to
# skip off-site upload. A copy here survives even a full Railway volume wipe.
BACKUP_S3_BUCKET=
# For R2: https://<account_id>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
# "auto" is correct for Cloudflare R2; use the AWS region for S3
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Key prefix inside the bucket (default: dukapilot-backups/)
BACKUP_S3_PREFIX=dukapilot-backups/

# --- Restore drill (never point this at production) ---
# A separate empty PostgreSQL database used only to prove a backup can restore.
RESTORE_DRILL_DATABASE_URL=
RESTORE_DRILL_BACKUP_FILE=

# --- Mobile Money (Tanzania) — future ---
# Vodacom M-Pesa
MPESA_API_URL=
MPESA_BUSINESS_SHORT_CODE=
MPESA_PASSKEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# nTZS subscription collections. Keep disabled until KYB, signed webhook and
# end-to-end settlement tests are complete. Never use NEXT_PUBLIC_ for secrets.
NTZS_ENABLED=false
NTZS_API_KEY=
NTZS_WEBHOOK_SECRET=

# Merchant balance wallet. This is intentionally separate from subscription
# checkout and stays disabled until a controlled live deposit and withdrawal
# have both reconciled correctly. The provider user ID is private and refers
# to DukaPilot's pooled merchant settlement wallet, never a customer wallet.
NTZS_MERCHANT_BALANCE_ENABLED=false
# Optional emergency/controlled-rollout allowlist of root shop IDs. Leave
# empty for normal production availability to every merchant owner.
NTZS_MERCHANT_BALANCE_PILOT_SHOP_IDS=
NTZS_MERCHANT_BALANCE_USER_ID=
NTZS_MERCHANT_BALANCE_WALLET_ADDRESS=
NTZS_MERCHANT_BALANCE_WITHDRAWAL_FEE_BPS=200
NTZS_MERCHANT_BALANCE_MIN_WITHDRAWAL_TZS=5000
# Strong random secret for the protected nTZS payout status sweep. Store the
# same value as MERCHANT_WALLET_RECONCILE_CRON_SECRET in GitHub Actions.
MERCHANT_WALLET_RECONCILE_CRON_SECRET=
