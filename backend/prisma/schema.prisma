generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MERCHANT
  SUPPLIER
  ADMIN
}

enum PaymentMethod {
  CASH
  MPESA
  TIGOPESA
  AIRTEL_MONEY
  HALOPESA
  BANK
  CREDIT
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum SaleChannel {
  POS
  ONLINE
}

enum PricingTier {
  RETAIL
  WHOLESALE
}

enum DebtStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

enum ExpenseCategory {
  RENT
  SALARY
  UTILITIES
  TRANSPORT
  STOCK
  MARKETING
  TAX
  OTHER
}

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  STOCK_CLERK
}

enum OnboardingStatus {
  NEW
  CONTACTED
  NEEDS_HELP
  SETUP_DONE
  ACTIVATED
  PAID
  CONVERTED
  CHURN_RISK
}

enum BarcodeType {
  EAN13
  UPC
  CODE128
  INTERNAL
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  ARCHIVED
  CANCELLED
}

enum QuotationItemCategory {
  MATERIAL
  LABOUR
  TRANSPORT
  DESIGN
  INSTALLATION
  SUBCONTRACTOR
  SERVICE
  OTHER
}

enum QuotationShareMethod {
  PDF
  PRINT
  LINK
  WHATSAPP
  EMAIL
}

enum QuotationPaymentStage {
  DEPOSIT
  MILESTONE
  FINAL
  OTHER
}

enum QuotationPaymentKind {
  PAYMENT
  REFUND
}

enum QuotationReminderType {
  EXPIRING_SOON
  DEPOSIT_OVERDUE
  VIEWED_NOT_ACCEPTED
}

enum FarmProfileType {
  LAYERS
  BROILERS
  DAIRY
  BEEF
  GOATS_SHEEP
  PIGS
  MIXED
}

enum FarmAnimalEventType {
  OPENING
  ADDITION
  MORTALITY
  CULL
}

enum FarmProductionType {
  EGGS
  MILK
  HARVEST
  OTHER
}

model User {
  branchTransfers BranchTransfer[]
  id              String           @id @default(cuid())
  phone           String           @unique
  pin             String
  name            String
  role            Role             @default(MERCHANT)
  language        String           @default("sw") // sw = Kiswahili, en = English
  sessionVersion  Int              @default(1)
  shop            Shop?
  supplier        Supplier?
  auditLogs       AuditLog[]
  reports         Report[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("users")
}

model Shop {
  businessTransfers        BranchTransfer[]        @relation("TransferBusiness")
  outgoingTransfers        BranchTransfer[]        @relation("TransferSourceShop")
  incomingTransfers        BranchTransfer[]        @relation("TransferTargetShop")
  id                       String                  @id @default(cuid())
  name                     String
  location                 String
  district                 String?
  category                 String                  @default("general") // grocery, pharmacy, beauty, bar, restaurant, general
  userId                   String?                 @unique
  user                     User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentShopId             String?
  parentShop               Shop?                   @relation("BusinessBranches", fields: [parentShopId], references: [id], onDelete: Restrict)
  branches                 Shop[]                  @relation("BusinessBranches")
  branchArchived           Boolean                 @default(false)
  products                 Product[]
  sales                    Sale[]
  orders                   Order[]
  customerOrders           CustomerOrder[]
  debts                    Debt[]
  expenses                 Expense[]
  recurringExpenses        RecurringExpense[]
  staffMembers             StaffMember[]
  additionalBranchSlots    Int                     @default(0)
  subscriptionPayments     SubscriptionPayment[]
  subscriptionCheckouts    SubscriptionCheckout[]
  merchantWallet           MerchantWallet?        @relation("MerchantWalletBusiness")
  merchantWalletTransactions MerchantWalletTransaction[] @relation("MerchantWalletTransactions")
  merchantWalletEntries    MerchantWalletEntry[]  @relation("MerchantWalletEntries")
  offlineSyncEvents        OfflineSyncEvent[]
  cropOperationReceipts    CropOperationReceipt[]
  assistantActions         AssistantAction[]
  pushSubscriptions        PushSubscription[]
  notificationPreference   NotificationPreference?
  pushDeliveries           PushDelivery[]
  appUsageEvents           AppUsageEvent[]
  barcodeScans             BarcodeScan[]
  stockCounts              StockCount[]
  cashSessions             CashSession[]
  stockReceipts            StockReceipt[]
  foodRecipes              FoodRecipe[]
  foodPreparationBatches   FoodPreparationBatch[]
  farmProfiles             FarmProfile[]
  farmGroups               FarmGroup[]
  farmProductionBatches    FarmProductionBatch[]
  farmPackConversions      FarmPackConversion[]
  farmSettings             FarmSettings?
  cropPlots                CropPlot[]
  cropCycles               CropCycle[]
  cropInputUsages          CropInputUsage[]
  cropHarvestBatches       CropHarvestBatch[]
  cropIrrigationLogs       CropIrrigationLog[]
  cropFieldTasks           CropFieldTask[]
  cropBuyerContracts       CropBuyerContract[]
  cropWeatherAlerts        CropWeatherAlert[]
  customers                Customer[]
  services                 Service[]
  quotations               Quotation[]
  quotationSettings        QuotationSettings?
  createdSuppliers         Supplier[]              @relation("SupplierCreatedByShop")
  referralsMade            ShopReferral[]          @relation("ShopReferralReferrer")
  referralReceived         ShopReferral?           @relation("ShopReferralReferred")
  // Subscription / trial
  plan                     String                  @default("FREE_TRIAL") // FREE_TRIAL, BASIC, PRO
  trialEndsAt              DateTime?
  subscriptionEndsAt       DateTime?
  isActive                 Boolean                 @default(true)
  isCatalogPublished       Boolean                 @default(true)
  isDemo                   Boolean                 @default(false)
  onboardingStatus         OnboardingStatus        @default(NEW)
  lastContactedAt          DateTime?
  followUpNotes            String?
  barcodeScanningEnabled   Boolean                 @default(true)
  bluetoothScannerEnabled  Boolean                 @default(true)
  barcodeGenerationEnabled Boolean                 @default(true)
  barcodeAutoFocus         Boolean                 @default(true)
  barcodeSuccessSound      Boolean                 @default(true)
  barcodeVibrate           Boolean                 @default(true)
  barcodeAutoAddToCart     Boolean                 @default(true)
  nextSaleNumber           Int                     @default(1)
  nextQuotationNumber      Int                     @default(1)
  acquisitionSource        String?
  acquisitionMedium        String?
  acquisitionCampaign      String?
  acquisitionContent       String?
  referralCode             String                  @unique
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([parentShopId, branchArchived])
  @@map("shops")
}

model ShopReferral {
  id             String    @id @default(cuid())
  referrerShopId String
  referrerShop   Shop      @relation("ShopReferralReferrer", fields: [referrerShopId], references: [id], onDelete: Cascade)
  referredShopId String    @unique
  referredShop   Shop      @relation("ShopReferralReferred", fields: [referredShopId], references: [id], onDelete: Cascade)
  referralCode   String
  status         String    @default("PENDING")
  qualifiedAt    DateTime?
  rewardedAt     DateTime?
  rewardedBy     String?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([referrerShopId, createdAt])
  @@index([status, createdAt])
  @@map("shop_referrals")
}

model MarketingEvent {
  id        String   @id @default(cuid())
  eventName String
  sessionId String
  pagePath  String?
  source    String?
  medium    String?
  campaign  String?
  content   String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([source, campaign, createdAt])
  @@map("marketing_events")
}

model PinResetOtp {
  phone      String   @id
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
  @@map("pin_reset_otps")
}

model SubscriptionCheckout {
  extraBranches  Int       @default(0)
  kind           String    @default("RENEWAL")
  expectedEndsAt DateTime?
  id             String    @id @default(cuid())
  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  requestKey     String    @unique
  activeShopKey  String?   @unique
  providerId     String?   @unique
  providerUserId String?
  plan           String
  amount         Int
  phone          String
  status         String    @default("PENDING")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([shopId, createdAt])
  @@index([status, updatedAt])
  @@map("subscription_checkouts")
}

model SubscriptionPayment {
  extraBranches       Int       @default(0)
  kind                String    @default("RENEWAL")
  id                  String    @id @default(cuid())
  shopId              String
  shop                Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan                String
  amount              Int
  months              Int       @default(1)
  method              String    @default("MANUAL")
  reference           String?
  normalizedReference String?   @unique
  status              String    @default("CONFIRMED")
  reviewedBy          String?
  reviewedAt          DateTime?
  proofUrl            String?
  sourceReportId      String?   @unique
  note                String?
  paidAt              DateTime  @default(now())
  createdAt           DateTime  @default(now())

  @@index([shopId, paidAt])
  @@map("subscription_payments")
}

// A business has one internal DukaPilot balance. The provider-facing wallet is
// deliberately shared and configured only on the server; merchants never see
// or control that provider identity directly.
model MerchantWallet {
  id             String                      @id @default(cuid())
  businessShopId String                      @unique
  businessShop   Shop                        @relation("MerchantWalletBusiness", fields: [businessShopId], references: [id], onDelete: Cascade)
  balanceTzs     Int                         @default(0)
  transactions   MerchantWalletTransaction[]
  entries        MerchantWalletEntry[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([balanceTzs])
  @@map("merchant_wallets")
}

// Provider interactions are separate from entries so a pending mobile-money
// request can reserve a balance without pretending that it has settled.
model MerchantWalletTransaction {
  id                String                @id @default(cuid())
  walletId          String
  wallet            MerchantWallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  shopId            String
  shop              Shop                  @relation("MerchantWalletTransactions", fields: [shopId], references: [id], onDelete: Cascade)
  kind              String
  status            String                @default("PENDING")
  requestKey        String                @unique
  amountTzs         Int
  platformFeeTzs    Int                   @default(0)
  providerFeeTzs    Int                   @default(0)
  totalDebitTzs     Int                   @default(0)
  payerPhone        String?
  recipientPhone    String?
  recipientName     String?
  payoutRail        String?
  providerId        String?               @unique
  providerQuoteId   String?
  providerStatus    String?
  providerInstruction String?
  failureCode       String?
  failureReason     String?
  requestedByUserId String?
  completedAt       DateTime?
  reversedAt        DateTime?
  metadata          Json?
  entries           MerchantWalletEntry[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([shopId, status, createdAt])
  @@index([walletId, createdAt])
  @@index([status, updatedAt])
  @@map("merchant_wallet_transactions")
}

// Entries are immutable. A failure or reversal is represented by a new
// compensating entry, never by editing or deleting an earlier movement.
model MerchantWalletEntry {
  id              String                     @id @default(cuid())
  walletId        String
  wallet          MerchantWallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transactionId   String
  transaction     MerchantWalletTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  shopId          String
  shop            Shop                       @relation("MerchantWalletEntries", fields: [shopId], references: [id], onDelete: Cascade)
  type            String
  direction       String
  amountTzs       Int
  balanceAfterTzs Int
  description     String?
  createdAt       DateTime                   @default(now())

  @@unique([transactionId, type])
  @@index([walletId, createdAt])
  @@index([shopId, createdAt])
  @@map("merchant_wallet_entries")
}

model OfflineSyncEvent {
  id               String    @id @default(cuid())
  shopId           String
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deviceId         String?
  deviceLabel      String?
  status           String
  total            Int?
  message          String?
  attempts         Int       @default(0)
  localId          String?
  operationKind    String    @default("SALE")
  resolutionStatus String    @default("OPEN")
  resolutionNote   String?
  contactedAt      DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([shopId, createdAt])
  @@index([status, createdAt])
  @@index([resolutionStatus, createdAt])
  @@index([shopId, operationKind, createdAt])
  @@map("offline_sync_events")
}

// A durable receipt makes a queued field operation safe to replay after a
// dropped response. The resource itself remains the source of truth.
model CropOperationReceipt {
  id              String   @id @default(cuid())
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  clientRequestId String
  operation       String
  resourceType    String
  resourceId      String
  createdAt       DateTime @default(now())

  @@unique([shopId, clientRequestId])
  @@index([shopId, createdAt])
  @@map("crop_operation_receipts")
}

model AssistantAction {
  id                String    @id @default(cuid())
  shopId            String
  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  actionKey         String
  title             String
  href              String
  status            String    @default("OPEN")
  source            String    @default("ASSISTANT")
  completedAt       DateTime?
  dismissedAt       DateTime?
  openedAt          DateTime?
  baselineValue     Int?
  outcomeValue      Int?
  outcomeVerifiedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([shopId, actionKey])
  @@index([shopId, status])
  @@index([createdAt])
  @@map("assistant_actions")
}

model PushSubscription {
  id           String         @id @default(cuid())
  shopId       String
  shop         Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  endpoint     String
  p256dh       String
  auth         String
  deviceId     String
  deviceLabel  String?
  userId       String?
  staffId      String?
  isActive     Boolean        @default(true)
  failureCount Int            @default(0)
  lastSeenAt   DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deliveries   PushDelivery[]

  @@unique([shopId, deviceId])
  @@index([shopId, isActive])
  @@index([endpoint])
  @@map("push_subscriptions")
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  shopId             String   @unique
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  lowStock           Boolean  @default(true)
  debtDue            Boolean  @default(true)
  subscriptionExpiry Boolean  @default(true)
  dailyAssistant     Boolean  @default(false)
  privatePreview     Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@map("notification_preferences")
}

model PushDelivery {
  id             String            @id @default(cuid())
  shopId         String
  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   PushSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  kind           String
  title          String
  body           String
  href           String            @default("/notifications")
  status         String            @default("QUEUED")
  attemptCount   Int               @default(0)
  lastError      String?
  scheduledFor   DateTime          @default(now())
  sentAt         DateTime?
  retryAt        DateTime?
  dedupeKey      String            @unique
  leaseId        String?
  leaseExpiresAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, retryAt, leaseExpiresAt])
  @@index([shopId, createdAt])
  @@map("push_deliveries")
}

model AppUsageEvent {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deviceId  String
  eventName String
  action    String?
  route     String
  userId    String?
  staffId   String?
  createdAt DateTime @default(now())

  @@index([shopId, eventName, createdAt])
  @@index([shopId, deviceId, createdAt])
  @@map("app_usage_events")
}

model Supplier {
  id                 String                   @id @default(cuid())
  name               String
  phone              String
  address            String?
  verificationStatus String                   @default("UNVERIFIED")
  verifiedAt         DateTime?
  adminNotes         String?
  createdByShopId    String?
  createdByShop      Shop?                    @relation("SupplierCreatedByShop", fields: [createdByShopId], references: [id], onDelete: SetNull)
  userId             String?                  @unique
  user               User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  products           Product[]
  quotationItems     QuotationItem[]
  catalogProducts    SupplierCatalogProduct[]
  orders             Order[]
  stockReceipts      StockReceipt[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@map("suppliers")
}

model Customer {
  id         String      @id @default(cuid())
  name       String
  phone      String?
  email      String?
  address    String?
  notes      String?
  shopId     String
  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  quotations Quotation[]
  sales      Sale[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([shopId, name])
  @@index([shopId, phone])
  @@index([shopId, email])
  @@map("customers")
}

model Service {
  id                       String          @id @default(cuid())
  name                     String
  description              String?
  unit                     String          @default("service")
  defaultSellingPrice      Int             @default(0)
  defaultEstimatedUnitCost Int             @default(0)
  isActive                 Boolean         @default(true)
  shopId                   String
  shop                     Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  quotationItems           QuotationItem[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([shopId, isActive, name])
  @@map("services")
}

model QuotationSettings {
  id                        String   @id @default(cuid())
  shopId                    String   @unique
  shop                      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  prefix                    String   @default("QT")
  numberingFormat           String   @default("{prefix}-{number}")
  defaultValidityDays       Int      @default(14)
  defaultCurrency           String   @default("TZS")
  defaultDocumentLanguage   String   @default("sw")
  defaultTaxRateBasisPoints Int      @default(0)
  defaultPaymentTerms       String?
  defaultTerms              String?
  defaultCustomerNote       String?
  signatureName             String?
  signatureUrl              String?
  showQuantities            Boolean  @default(true)
  showUnitPrices            Boolean  @default(true)
  showItemDiscounts         Boolean  @default(true)
  showSections              Boolean  @default(true)
  defaultDepositPercent     Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("quotation_settings")
}

model Quotation {
  id                    String              @id @default(cuid())
  quotationNumber       String
  currentRevisionNumber Int                 @default(1)
  status                QuotationStatus     @default(DRAFT)
  issueDate             DateTime            @default(now())
  expiryDate            DateTime?
  projectTitle          String
  projectType           String?
  scopeOfWork           String?
  currency              String              @default("TZS")
  documentLanguage      String              @default("sw")
  customerNote          String?
  internalNote          String?
  termsAndConditions    String?
  paymentTerms          String?
  discountAmount        Int                 @default(0)
  taxRateBasisPoints    Int                 @default(0)
  subtotalAmount        Int                 @default(0)
  taxAmount             Int                 @default(0)
  totalAmount           Int                 @default(0)
  amountPaid            Int                 @default(0)
  depositPercent        Int                 @default(0)
  depositRequiredAmount Int                 @default(0)
  depositDueDate        DateTime?
  sentAt                DateTime?
  acceptedAt            DateTime?
  acceptedByName        String?
  acceptanceComment     String?
  acceptanceSignature   String?
  rejectedAt            DateTime?
  rejectionReason       String?
  archivedAt            DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  createdById           String
  lastEditedById        String
  customerId            String
  customer              Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shopId                String
  shop                  Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sections              QuotationSection[]
  items                 QuotationItem[]
  revisions             QuotationRevision[]
  shares                QuotationShare[]
  payments              QuotationPayment[]
  reminders             QuotationReminder[]
  convertedSale         Sale?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([shopId, quotationNumber])
  @@index([shopId, status, issueDate])
  @@index([shopId, customerId, createdAt])
  @@index([shopId, expiryDate])
  @@index([status, expiryDate])
  @@index([status, depositDueDate])
  @@map("quotations")
}

model QuotationSection {
  id                String          @id @default(cuid())
  quotationId       String
  quotation         Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name              String
  position          Int
  visibleToCustomer Boolean         @default(true)
  items             QuotationItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([quotationId, position])
  @@map("quotation_sections")
}

model QuotationItem {
  id                       String                @id @default(cuid())
  quotationId              String
  quotation                Quotation             @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sectionId                String?
  section                  QuotationSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  position                 Int
  category                 QuotationItemCategory @default(OTHER)
  name                     String
  description              String?
  quantityMilli            Int                   @default(1000)
  unit                     String                @default("pcs")
  unitPrice                Int
  discountAmount           Int                   @default(0)
  taxRateBasisPoints       Int                   @default(0)
  lineSubtotal             Int
  taxAmount                Int                   @default(0)
  totalSellingPrice        Int
  visibleToCustomer        Boolean               @default(true)
  productId                String?
  product                  Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  serviceId                String?
  service                  Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  estimatedUnitCost        Int                   @default(0)
  estimatedTotalCost       Int                   @default(0)
  supplierId               String?
  supplier                 Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  internalNote             String?
  markupBasisPoints        Int                   @default(0)
  estimatedProfit          Int                   @default(0)
  estimatedProfitMarginBps Int                   @default(0)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@index([quotationId, position])
  @@index([productId])
  @@map("quotation_items")
}

model QuotationRevision {
  id             String    @id @default(cuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revisionNumber Int
  snapshot       Json
  publicSnapshot Json
  changeSummary  String?
  changedById    String
  createdAt      DateTime  @default(now())

  @@unique([quotationId, revisionNumber])
  @@index([quotationId, createdAt])
  @@map("quotation_revisions")
}

model QuotationShare {
  id             String               @id @default(cuid())
  quotationId    String
  quotation      Quotation            @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revisionNumber Int
  token          String               @unique
  method         QuotationShareMethod
  sentTo         String?
  createdById    String
  createdAt      DateTime             @default(now())
  viewedAt       DateTime?
  acceptedAt     DateTime?

  @@index([quotationId, revisionNumber])
  @@index([quotationId, viewedAt])
  @@map("quotation_shares")
}

model QuotationPayment {
  id             String                @id @default(cuid())
  quotationId    String
  quotation      Quotation             @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  amount         Int
  kind           QuotationPaymentKind  @default(PAYMENT)
  stage          QuotationPaymentStage @default(OTHER)
  paymentMethod  PaymentMethod         @default(CASH)
  paymentRef     String?
  idempotencyKey String?
  note           String?
  paidAt         DateTime              @default(now())
  recordedById   String
  debtPaymentId  String?               @unique
  cashSessionId  String?
  cashSession    CashSession?          @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())

  @@unique([quotationId, idempotencyKey])
  @@index([quotationId, paidAt])
  @@index([cashSessionId, paymentMethod])
  @@map("quotation_payments")
}

model QuotationReminder {
  id             String                @id @default(cuid())
  quotationId    String
  quotation      Quotation             @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  type           QuotationReminderType
  revisionNumber Int
  sentAt         DateTime              @default(now())

  @@unique([quotationId, type, revisionNumber])
  @@index([sentAt])
  @@map("quotation_reminders")
}

model Product {
  outgoingTransfers        BranchTransfer[]        @relation("TransferSourceProduct")
  incomingTransfers        BranchTransfer[]        @relation("TransferTargetProduct")
  id                       String                  @id @default(cuid())
  name                     String
  sku                      String?
  barcode                  String?
  barcodeType              BarcodeType?
  barcodeGenerated         Boolean                 @default(false)
  barcodeCreatedAt         DateTime?
  barcodeUpdatedAt         DateTime?
  unit                     String                  @default("pcs") // pcs, kg, litre, box, crate
  buyingPrice              Int
  sellingPrice             Int
  wholesalePrice           Int?
  wholesaleMinQty          Int?
  currentStock             Int                     @default(0)
  minimumStock             Int                     @default(5) // low-stock threshold
  expiryDate               DateTime? // null = not set
  doesNotExpire            Boolean                 @default(false)
  isActive                 Boolean                 @default(true)
  shopId                   String
  shop                     Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplierId               String?
  supplier                 Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierCatalogProductId String?
  supplierCatalogProduct   SupplierCatalogProduct? @relation("SupplierCatalogProductInventoryMapping", fields: [supplierCatalogProductId], references: [id], onDelete: SetNull)
  saleItems                SaleItem[]
  quotationItems           QuotationItem[]
  orderItems               OrderItem[]
  customerOrderItems       CustomerOrderItem[]
  stockMovements           StockMovement[]
  stockReceiptItems        StockReceiptItem[]
  barcodeScans             BarcodeScan[]
  stockCountItems          StockCountItem[]
  foodRecipeOutputs        FoodRecipe[]            @relation("FoodRecipeOutput")
  foodRecipeIngredients    FoodRecipeItem[]
  foodPreparationOutputs   FoodPreparationBatch[]  @relation("FoodPreparationOutput")
  foodPreparationInputs    FoodPreparationItem[]
  farmProductionOutputs    FarmProductionBatch[]   @relation("FarmProductionOutput")
  farmProductionInputs     FarmProductionItem[]    @relation("FarmProductionInput")
  farmPackInputs           FarmPackConversion[]    @relation("FarmPackInput")
  farmPackOutputs          FarmPackConversion[]    @relation("FarmPackOutput")
  cropInputUsages          CropInputUsage[]        @relation("CropInputProduct")
  cropHarvestBatches       CropHarvestBatch[]      @relation("CropHarvestOutput")
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@unique([shopId, supplierCatalogProductId])
  @@unique([shopId, barcode])
  @@index([shopId, isActive])
  @@map("products")
}

model BarcodeScan {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  barcode   String
  context   String   @default("POS")
  found     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([shopId, barcode])
  @@index([shopId, createdAt])
  @@map("barcode_scans")
}

model StockCount {
  id          String           @id @default(cuid())
  shopId      String
  shop        Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  status      String           @default("OPEN")
  createdById String
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       StockCountItem[]

  @@index([shopId, status])
  @@map("stock_counts")
}

model StockCountItem {
  id           String     @id @default(cuid())
  stockCountId String
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  expected     Int
  counted      Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([stockCountId, productId])
  @@map("stock_count_items")
}

model SupplierCatalogProduct {
  id               String    @id @default(cuid())
  supplierId       String
  supplier         Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name             String
  sku              String?
  unit             String    @default("pcs")
  price            Int
  minOrderQty      Int       @default(1)
  note             String?
  isAvailable      Boolean   @default(true)
  merchantProducts Product[] @relation("SupplierCatalogProductInventoryMapping")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([supplierId, isAvailable])
  @@map("supplier_catalog_products")
}

model BranchTransfer {
  business        Shop     @relation("TransferBusiness", fields: [businessId], references: [id], onDelete: Restrict)
  sourceShop      Shop     @relation("TransferSourceShop", fields: [sourceShopId], references: [id], onDelete: Restrict)
  targetShop      Shop     @relation("TransferTargetShop", fields: [targetShopId], references: [id], onDelete: Restrict)
  sourceProduct   Product  @relation("TransferSourceProduct", fields: [sourceProductId], references: [id], onDelete: Restrict)
  targetProduct   Product  @relation("TransferTargetProduct", fields: [targetProductId], references: [id], onDelete: Restrict)
  creator         User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  id              String   @id @default(cuid())
  businessId      String
  requestKey      String
  sourceShopId    String
  targetShopId    String
  sourceProductId String
  targetProductId String
  quantity        Int
  unitCost        Int
  createdBy       String
  createdAt       DateTime @default(now())

  @@unique([businessId, requestKey])
  @@index([businessId, createdAt])
  @@map("branch_transfers")
}

model StockMovement {
  id                     String                @id @default(cuid())
  type                   StockMovementType
  quantity               Int
  note                   String?
  productId              String
  product                Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockReceiptId         String?
  stockReceipt           StockReceipt?         @relation(fields: [stockReceiptId], references: [id], onDelete: SetNull)
  foodPreparationBatchId String?
  foodPreparationBatch   FoodPreparationBatch? @relation(fields: [foodPreparationBatchId], references: [id], onDelete: SetNull)
  cropHarvestBatchId     String?
  cropHarvestBatch       CropHarvestBatch?     @relation(fields: [cropHarvestBatchId], references: [id], onDelete: SetNull)
  createdAt              DateTime              @default(now())

  @@index([productId, createdAt])
  @@map("stock_movements")
}

model Sale {
  id              String         @id @default(cuid())
  totalAmount     Int
  profit          Int            @default(0)
  paymentMethod   PaymentMethod  @default(CASH)
  paymentRef      String? // M-Pesa transaction reference
  channel         SaleChannel    @default(POS)
  pricingTier     PricingTier    @default(RETAIL)
  customerPhone   String?
  customerName    String?
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quotationId     String?        @unique
  quotation       Quotation?     @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  customerOrderId String?        @unique
  customerOrder   CustomerOrder? @relation(fields: [customerOrderId], references: [id], onDelete: SetNull)
  note            String?
  clientReference String?
  receiptNumber   Int?
  status          String         @default("COMPLETED")
  voidedAt        DateTime?
  voidReason      String?
  voidedBy        String?
  cashSessionId   String?
  cashSession     CashSession?   @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  shopId          String
  shop            Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items           SaleItem[]
  debt            Debt?
  createdAt       DateTime       @default(now())

  @@unique([shopId, clientReference])
  @@unique([shopId, receiptNumber])
  @@index([shopId, createdAt])
  @@index([shopId, status, createdAt])
  @@index([shopId, customerId, createdAt])
  @@index([cashSessionId, paymentMethod, status])
  @@map("sales")
}

model Debt {
  id            String        @id @default(cuid())
  customerName  String?
  customerPhone String
  amount        Int
  amountPaid    Int           @default(0)
  dueDate       DateTime?
  note          String?
  status        DebtStatus    @default(OPEN)
  shopId        String
  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  saleId        String?       @unique
  sale          Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  payments      DebtPayment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([shopId, status])
  @@index([shopId, status, createdAt])
  @@index([customerPhone])
  @@map("debts")
}

model DebtPayment {
  id            String        @id @default(cuid())
  debtId        String
  debt          Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount        Int
  paymentMethod PaymentMethod @default(CASH)
  paymentRef    String?
  requestKey    String?
  note          String?
  recordedBy    String?
  cashSessionId String?
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  @@unique([debtId, requestKey])
  @@index([debtId, createdAt])
  @@index([cashSessionId, paymentMethod])
  @@map("debt_payments")
}

model Expense {
  id            String          @id @default(cuid())
  title         String
  amount        Int
  category      ExpenseCategory @default(OTHER)
  vendor        String?
  note          String?
  paymentMethod PaymentMethod   @default(CASH)
  spentAt       DateTime        @default(now())
  shopId        String
  shop          Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cashSessionId String?
  cashSession   CashSession?    @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([shopId, spentAt])
  @@index([shopId, category])
  @@index([cashSessionId, paymentMethod])
  @@map("expenses")
}

model RecurringExpense {
  id            String          @id @default(cuid())
  title         String
  amount        Int
  category      ExpenseCategory @default(OTHER)
  vendor        String?
  note          String?
  paymentMethod PaymentMethod   @default(CASH)
  nextDueAt     DateTime
  isActive      Boolean         @default(true)
  shopId        String
  shop          Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([shopId, isActive, nextDueAt])
  @@map("recurring_expenses")
}

model StaffMember {
  id                           String    @id @default(cuid())
  name                         String
  phone                        String?   @unique
  pin                          String?
  language                     String    @default("sw")
  sessionVersion               Int       @default(1)
  role                         StaffRole @default(CASHIER)
  canSell                      Boolean   @default(true)
  canManageStock               Boolean   @default(false)
  canManageFarm                Boolean   @default(false)
  canManageStaff               Boolean   @default(false)
  canViewReports               Boolean   @default(false)
  canRecordExpenses            Boolean   @default(false)
  canManageCashSessions        Boolean   @default(false)
  canUseAssistant              Boolean   @default(false)
  canViewQuotations            Boolean   @default(false)
  canCreateQuotations          Boolean   @default(false)
  canEditSentQuotations        Boolean   @default(false)
  canViewQuotationCosts        Boolean   @default(false)
  canApproveQuotationDiscounts Boolean   @default(false)
  canSendQuotations            Boolean   @default(false)
  canAcceptQuotations          Boolean   @default(false)
  canConvertQuotations         Boolean   @default(false)
  canRecordQuotationPayments   Boolean   @default(false)
  canArchiveQuotations         Boolean   @default(false)
  canDeleteQuotationDrafts     Boolean   @default(false)
  isActive                     Boolean   @default(true)
  shopId                       String
  shop                         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@index([shopId, role])
  @@map("staff_members")
}

model SaleItem {
  id                     String                  @id @default(cuid())
  quantity               Int
  unitPrice              Int
  buyingPrice            Int
  totalPrice             Int
  saleId                 String
  sale                   Sale                    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId              String?
  product                Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  name                   String?
  description            String?
  unit                   String?
  quotedQuantityMilli    Int?
  cropHarvestAllocations CropHarvestAllocation[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Order {
  id           String        @id @default(cuid())
  status       OrderStatus   @default(PENDING)
  totalAmount  Int?
  note         String?
  shopId       String
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Supplier      @relation(fields: [supplierId], references: [id])
  items        OrderItem[]
  stockReceipt StockReceipt?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([shopId, status])
  @@index([shopId, createdAt])
  @@map("orders")
}

model CashSession {
  id                     String                 @id @default(cuid())
  status                 CashSessionStatus      @default(OPEN)
  openingCash            Int                    @default(0)
  expectedCash           Int?
  countedCash            Int?
  variance               Int?
  note                   String?
  openedById             String
  openedByName           String
  openedAt               DateTime               @default(now())
  closedAt               DateTime?
  shopId                 String
  shop                   Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales                  Sale[]
  expenses               Expense[]
  debtPayments           DebtPayment[]
  quotationPayments      QuotationPayment[]
  stockReceipts          StockReceipt[]
  foodPreparationBatches FoodPreparationBatch[]
  farmProductionBatches  FarmProductionBatch[]
  cropInputUsages        CropInputUsage[]

  @@index([shopId, status, openedAt])
  @@index([shopId, openedById, status])
  @@map("cash_sessions")
}

model StockReceipt {
  id                  String             @id @default(cuid())
  invoiceNumber       String?
  paymentMethod       PaymentMethod      @default(CASH)
  transportCost       Int                @default(0)
  otherCost           Int                @default(0)
  totalProductCost    Int
  totalLandedCost     Int
  allocationMode      String             @default("DIRECT")
  estimatedAllocation Boolean            @default(false)
  note                String?
  receivedBy          String?
  receivedAt          DateTime           @default(now())
  shopId              String
  shop                Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplierId          String?
  supplier            Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  sourceOrderId       String?            @unique
  sourceOrder         Order?             @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)
  cashSessionId       String?
  cashSession         CashSession?       @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  items               StockReceiptItem[]
  stockMovements      StockMovement[]
  createdAt           DateTime           @default(now())

  @@index([shopId, receivedAt])
  @@index([supplierId, receivedAt])
  @@index([cashSessionId, paymentMethod])
  @@map("stock_receipts")
}

// A reusable recipe describes expected ingredient usage. It does not move
// stock or create costs: that happens only when a preparation batch is made.
model FoodRecipe {
  id              String                 @id @default(cuid())
  name            String
  instructions    String?
  expectedYield   Int
  shopId          String
  shop            Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  outputProductId String
  outputProduct   Product                @relation("FoodRecipeOutput", fields: [outputProductId], references: [id], onDelete: Cascade)
  isActive        Boolean                @default(true)
  items           FoodRecipeItem[]
  batches         FoodPreparationBatch[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([shopId, isActive, updatedAt])
  @@index([shopId, outputProductId])
  @@map("food_recipes")
}

model FoodRecipeItem {
  id        String     @id @default(cuid())
  recipeId  String
  recipe    FoodRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int

  @@unique([recipeId, productId])
  @@index([productId])
  @@map("food_recipe_items")
}

// A completed batch is an immutable stock conversion: ingredient stock out,
// prepared/menu item stock in. Its cost is the cost actually available at the
// time it was prepared, plus optional direct preparation costs.
model FoodPreparationBatch {
  id                 String                @id @default(cuid())
  shopId             String
  shop               Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  recipeId           String?
  recipe             FoodRecipe?           @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  outputProductId    String
  outputProduct      Product               @relation("FoodPreparationOutput", fields: [outputProductId], references: [id], onDelete: Restrict)
  expectedYield      Int
  actualYield        Int
  wasteQuantity      Int                   @default(0)
  ingredientCost     Int
  additionalCost     Int                   @default(0)
  totalCost          Int
  unitCost           Int
  additionalCostNote String?
  paymentMethod      PaymentMethod         @default(CASH)
  cashSessionId      String?
  cashSession        CashSession?          @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  note               String?
  preparedAt         DateTime              @default(now())
  preparedBy         String?
  items              FoodPreparationItem[]
  stockMovements     StockMovement[]
  createdAt          DateTime              @default(now())

  @@index([shopId, preparedAt])
  @@index([shopId, outputProductId, preparedAt])
  @@index([cashSessionId, paymentMethod])
  @@map("food_preparation_batches")
}

model FoodPreparationItem {
  id                String               @id @default(cuid())
  foodPreparationId String
  foodPreparation   FoodPreparationBatch @relation(fields: [foodPreparationId], references: [id], onDelete: Cascade)
  productId         String
  product           Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity          Int
  unitCost          Int
  totalCost         Int

  @@unique([foodPreparationId, productId])
  @@index([productId])
  @@map("food_preparation_items")
}

// Farm profiles select the production workflows a livestock business uses.
// They intentionally sit below the broad shop category so one farm can raise
// layers and goats without changing its business identity.
model FarmProfile {
  id        String          @id @default(cuid())
  shopId    String
  shop      Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type      FarmProfileType
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([shopId, type])
  @@index([shopId, isActive])
  @@map("farm_profiles")
}

// A group is a flock, pen, herd, or rearing batch. The first release stays
// group-based so small farms do not have to create a record for every animal.
model FarmGroup {
  id                String                @id @default(cuid())
  shopId            String
  shop              Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  profileType       FarmProfileType
  name              String
  currentAnimals    Int                   @default(0)
  isActive          Boolean               @default(true)
  note              String?
  events            FarmAnimalEvent[]
  productionBatches FarmProductionBatch[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([shopId, profileType, isActive])
  @@index([shopId, updatedAt])
  @@map("farm_groups")
}

model FarmAnimalEvent {
  id         String              @id @default(cuid())
  groupId    String
  group      FarmGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type       FarmAnimalEventType
  quantity   Int
  note       String?
  occurredAt DateTime            @default(now())
  recordedBy String?
  createdAt  DateTime            @default(now())

  @@index([groupId, occurredAt])
  @@map("farm_animal_events")
}

// A production batch consumes farm supplies and creates sellable output stock
// such as individual eggs, milk in millilitres, or harvested animals.
model FarmProductionBatch {
  id                 String               @id @default(cuid())
  shopId             String
  shop               Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  groupId            String
  group              FarmGroup            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  type               FarmProductionType   @default(OTHER)
  outputProductId    String
  outputProduct      Product              @relation("FarmProductionOutput", fields: [outputProductId], references: [id], onDelete: Restrict)
  expectedYield      Int
  actualYield        Int
  wasteQuantity      Int                  @default(0)
  ingredientCost     Int
  additionalCost     Int                  @default(0)
  totalCost          Int
  unitCost           Int
  additionalCostNote String?
  paymentMethod      PaymentMethod        @default(CASH)
  cashSessionId      String?
  cashSession        CashSession?         @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  note               String?
  producedAt         DateTime             @default(now())
  producedBy         String?
  items              FarmProductionItem[]
  createdAt          DateTime             @default(now())

  @@index([shopId, producedAt])
  @@index([shopId, outputProductId, producedAt])
  @@index([groupId, producedAt])
  @@index([cashSessionId, paymentMethod])
  @@map("farm_production_batches")
}

model FarmProductionItem {
  id               String              @id @default(cuid())
  farmProductionId String
  farmProduction   FarmProductionBatch @relation(fields: [farmProductionId], references: [id], onDelete: Cascade)
  productId        String
  product          Product             @relation("FarmProductionInput", fields: [productId], references: [id], onDelete: Restrict)
  quantity         Int
  unitCost         Int
  totalCost        Int

  @@unique([farmProductionId, productId])
  @@index([productId])
  @@map("farm_production_items")
}

// Packaging keeps one base stock unit accurate. A layer farm can convert 30
// individual eggs into one tray without creating imaginary purchased stock.
model FarmPackConversion {
  id              String   @id @default(cuid())
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  inputProductId  String
  inputProduct    Product  @relation("FarmPackInput", fields: [inputProductId], references: [id], onDelete: Restrict)
  outputProductId String
  outputProduct   Product  @relation("FarmPackOutput", fields: [outputProductId], references: [id], onDelete: Restrict)
  inputQuantity   Int
  outputQuantity  Int
  totalCost       Int
  unitCost        Int
  note            String?
  convertedAt     DateTime @default(now())
  convertedBy     String?
  createdAt       DateTime @default(now())

  @@index([shopId, convertedAt])
  @@index([inputProductId])
  @@index([outputProductId])
  @@map("farm_pack_conversions")
}

// Farm settings deliberately distinguish crops from livestock. A farm may run
// either operation or both without forcing crop growers through animal forms.
model FarmSettings {
  id           String   @id @default(cuid())
  shopId       String   @unique
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  hasLivestock Boolean  @default(false)
  hasCrops     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("farm_settings")
}

// A plot is a physical field, bed, greenhouse, or other growing area. Area is
// stored in thousandths to avoid floating-point drift for acres and hectares.
model CropPlot {
  id                String             @id @default(cuid())
  shopId            String
  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name              String
  location          String?
  areaMilli         Int                @default(0)
  areaUnit          String             @default("ACRE")
  note              String?
  isActive          Boolean            @default(true)
  cycles            CropCycle[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cropWeatherAlerts CropWeatherAlert[]

  @@index([shopId, isActive, updatedAt])
  @@map("crop_plots")
}

// A crop cycle connects growing work, input costs, harvest, and reporting to a
// single planting on a particular plot.
model CropCycle {
  id                String              @id @default(cuid())
  shopId            String
  shop              Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plotId            String
  plot              CropPlot            @relation(fields: [plotId], references: [id], onDelete: Restrict)
  cropName          String
  variety           String?
  status            String              @default("PLANTED")
  plantedAt         DateTime
  expectedHarvestAt DateTime?
  expectedYield     Int?
  yieldUnit         String?
  note              String?
  closedAt          DateTime?
  unrecoveredCost   Int                 @default(0)
  costReconciledAt  DateTime?
  inputUsages       CropInputUsage[]
  harvestBatches    CropHarvestBatch[]
  seasonBudget      CropSeasonBudget?
  irrigationLogs    CropIrrigationLog[]
  fieldTasks        CropFieldTask[]
  buyerContracts    CropBuyerContract[]
  weatherAlerts     CropWeatherAlert[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([shopId, status, expectedHarvestAt])
  @@index([plotId, plantedAt])
  @@map("crop_cycles")
}

// Inputs can consume existing stock (seed, fertilizer, pesticide) or record a
// direct crop cost such as labour, transport, or irrigation.
model CropInputUsage {
  id              String                    @id @default(cuid())
  shopId          String
  shop            Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cropCycleId     String
  cropCycle       CropCycle                 @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?                  @relation("CropInputProduct", fields: [productId], references: [id], onDelete: SetNull)
  category        String                    @default("OTHER")
  title           String
  quantity        Int?
  unitCost        Int?
  totalCost       Int
  paymentMethod   PaymentMethod             @default(CASH)
  cashSessionId   String?
  cashSession     CashSession?              @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  note            String?
  usedAt          DateTime                  @default(now())
  recordedBy      String?
  clientRequestId String?
  costAllocations CropInputCostAllocation[]
  createdAt       DateTime                  @default(now())

  @@unique([shopId, clientRequestId])
  @@index([shopId, usedAt])
  @@index([cropCycleId, usedAt])
  @@index([productId])
  @@index([cashSessionId, paymentMethod])
  @@map("crop_input_usages")
}

// A harvest batch turns a crop cycle into sellable stock. Remaining quantity and
// cost are consumed by POS allocations, keeping crop revenue and profit honest.
model CropHarvestBatch {
  id                   String                    @id @default(cuid())
  shopId               String
  shop                 Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cropCycleId          String
  cropCycle            CropCycle                 @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  outputProductId      String
  outputProduct        Product                   @relation("CropHarvestOutput", fields: [outputProductId], references: [id], onDelete: Restrict)
  expectedYield        Int?
  actualYield          Int
  wasteQuantity        Int                       @default(0)
  totalCost            Int                       @default(0)
  unitCost             Int                       @default(0)
  remainingQuantity    Int
  remainingCost        Int                       @default(0)
  soldQuantity         Int                       @default(0)
  realizedRevenue      Int                       @default(0)
  realizedCost         Int                       @default(0)
  harvestAt            DateTime                  @default(now())
  note                 String?
  recordedBy           String?
  clientRequestId      String?
  stockMovements       StockMovement[]
  allocations          CropHarvestAllocation[]
  inputCostAllocations CropInputCostAllocation[]
  grades               CropHarvestGrade[]
  createdAt            DateTime                  @default(now())

  @@unique([shopId, clientRequestId])
  @@index([shopId, outputProductId, harvestAt])
  @@index([cropCycleId, harvestAt])
  @@map("crop_harvest_batches")
}

// Each cost allocation is durable. It links a recorded input to exactly one
// harvest batch and never rewrites the cost of produce already sold.
model CropInputCostAllocation {
  id               String           @id @default(cuid())
  cropInputUsageId String
  cropInputUsage   CropInputUsage   @relation(fields: [cropInputUsageId], references: [id], onDelete: Cascade)
  harvestBatchId   String
  harvestBatch     CropHarvestBatch @relation(fields: [harvestBatchId], references: [id], onDelete: Cascade)
  amount           Int
  reason           String           @default("HARVEST")
  createdAt        DateTime         @default(now())

  @@unique([cropInputUsageId, harvestBatchId, reason])
  @@index([harvestBatchId])
  @@map("crop_input_cost_allocations")
}

model CropSeasonBudget {
  id             String    @id @default(cuid())
  cropCycleId    String    @unique
  cropCycle      CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  plannedCost    Int       @default(0)
  plannedRevenue Int?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("crop_season_budgets")
}

model CropIrrigationLog {
  id              String    @id @default(cuid())
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cropCycleId     String
  cropCycle       CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  amount          Int?
  unit            String?
  durationMinutes Int?
  irrigatedAt     DateTime  @default(now())
  note            String?
  recordedBy      String?
  clientRequestId String?
  createdAt       DateTime  @default(now())

  @@unique([shopId, clientRequestId])
  @@index([cropCycleId, irrigatedAt])
  @@map("crop_irrigation_logs")
}

model CropFieldTask {
  id              String     @id @default(cuid())
  shopId          String
  shop            Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cropCycleId     String?
  cropCycle       CropCycle? @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  title           String
  status          String     @default("TODO")
  priority        String     @default("NORMAL")
  dueAt           DateTime?
  completedAt     DateTime?
  assignedStaffId String?
  note            String?
  recordedBy      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([shopId, status, dueAt])
  @@index([cropCycleId, status])
  @@map("crop_field_tasks")
}

model CropBuyerContract {
  id          String     @id @default(cuid())
  shopId      String
  shop        Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cropCycleId String?
  cropCycle   CropCycle? @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  buyerName   String
  buyerPhone  String?
  produceName String
  quantity    Int
  unit        String     @default("kg")
  unitPrice   Int?
  deliveryAt  DateTime?
  status      String     @default("DRAFT")
  note        String?
  recordedBy  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([shopId, status, deliveryAt])
  @@index([cropCycleId])
  @@map("crop_buyer_contracts")
}

model CropHarvestGrade {
  id             String           @id @default(cuid())
  harvestBatchId String
  harvestBatch   CropHarvestBatch @relation(fields: [harvestBatchId], references: [id], onDelete: Cascade)
  grade          String
  quantity       Int
  unit           String?
  note           String?
  recordedBy     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([harvestBatchId, grade])
  @@map("crop_harvest_grades")
}

// Weather alerts are manual farm observations until a verified provider and
// localized forecast contract are configured. This prevents false forecasts.
model CropWeatherAlert {
  id          String     @id @default(cuid())
  shopId      String
  shop        Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cropPlotId  String?
  cropPlot    CropPlot?  @relation(fields: [cropPlotId], references: [id], onDelete: SetNull)
  cropCycleId String?
  cropCycle   CropCycle? @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  type        String     @default("WEATHER")
  severity    String     @default("INFO")
  message     String
  source      String     @default("MANUAL")
  startsAt    DateTime   @default(now())
  expiresAt   DateTime?
  isResolved  Boolean    @default(false)
  resolvedAt  DateTime?
  recordedBy  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([shopId, isResolved, startsAt])
  @@index([cropCycleId])
  @@map("crop_weather_alerts")
}

model CropHarvestAllocation {
  id             String           @id @default(cuid())
  harvestBatchId String
  harvestBatch   CropHarvestBatch @relation(fields: [harvestBatchId], references: [id], onDelete: Cascade)
  saleItemId     String
  saleItem       SaleItem         @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  quantity       Int
  revenue        Int
  cost           Int
  createdAt      DateTime         @default(now())

  @@unique([harvestBatchId, saleItemId])
  @@index([saleItemId])
  @@map("crop_harvest_allocations")
}

model StockReceiptItem {
  id                      String       @id @default(cuid())
  quantity                Int
  unitCost                Int
  productCost             Int
  allocatedAdditionalCost Int
  landedTotalCost         Int
  landedUnitCost          Int
  stockReceiptId          String
  stockReceipt            StockReceipt @relation(fields: [stockReceiptId], references: [id], onDelete: Cascade)
  productId               String
  product                 Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([stockReceiptId])
  @@index([productId])
  @@map("stock_receipt_items")
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  unitPrice Int?
  productId String
  product   Product @relation(fields: [productId], references: [id])
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model CustomerOrder {
  id            String              @id @default(cuid())
  customerName  String
  customerPhone String
  note          String?
  status        OrderStatus         @default(PENDING)
  totalAmount   Int                 @default(0)
  shopId        String
  shop          Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items         CustomerOrderItem[]
  convertedSale Sale?
  convertedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([shopId, status, createdAt])
  @@map("customer_orders")
}

model CustomerOrderItem {
  id          String        @id @default(cuid())
  quantity    Int
  unitPrice   Int
  buyingPrice Int?
  pricingTier PricingTier   @default(RETAIL)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  orderId     String
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("customer_order_items")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  method       String
  path         String
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resourceType, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Report {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ReportType   @default(OTHER)
  title       String
  description String
  status      ReportStatus @default(OPEN)
  priority    Priority     @default(MEDIUM)
  adminNotes  String?
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@map("reports")
}

enum ReportType {
  BUG
  FEATURE_REQUEST
  ACCOUNT_ISSUE
  BILLING
  OTHER
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
