{
  "name": "dukapilot-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:prod": "next start",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-test.js",
    "smoke:login": "cross-env PLAYWRIGHT_BASE_URL=https://www.dukapilot.com playwright test tests/login.smoke.spec.ts",
    "test:auth": "playwright test tests/auth.negative.spec.ts",
    "test:inventory": "playwright test tests/inventory.flows.spec.ts",
    "test:supplier": "playwright test tests/supplier.portal.spec.ts",
    "test:mocked": "playwright test tests/auth.negative.spec.ts tests/inventory.flows.spec.ts tests/supplier.portal.spec.ts",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@zxing/browser": "^0.2.1",
    "clsx": "^2.1.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "brace-expansion": "5.0.9",
    "fast-uri": "4.1.1",
    "sharp": "0.35.3"
  }
}
